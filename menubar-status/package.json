{
  "name": "@local/dsh-menubar-status",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "macOS 菜单栏常驻图标，实时显示运行中 / 已完成与待答复的会话数，点击唤起 DeepSeek Harness",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "assets",
    "src",
    "bin",
    "build.sh"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
