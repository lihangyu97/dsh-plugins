{
  "name": "@local/dsh-chat-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "左侧栏入口 + 常驻内嵌浏览器：打开 DeepSeek 等聊天网页版，支持站点切换和自定义站点",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
